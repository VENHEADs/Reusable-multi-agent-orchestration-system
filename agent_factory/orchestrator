#!/usr/bin/env bash
set -euo pipefail

# load centralized configuration
ORIGINAL_PWD="$(pwd)"
AGENT_FACTORY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${AGENT_FACTORY_DIR}/.." && pwd)"
cd "$REPO_ROOT"
if [[ -f "${AGENT_FACTORY_DIR}/config.sh" ]]; then
  source "${AGENT_FACTORY_DIR}/config.sh"
fi

usage() {
  cat <<'EOF'
usage: orchestrator --profile <path> [options]

required:
  --profile <path>           profile markdown file

optional:
  --agent-bin <path>         agent CLI path (default: from $AGENT_BIN or PATH)
  --provider <name>          provider to use: cursor or antigravity (default: from $AGENT_PROVIDER)
  --api-key <key>            API key (default: from provider env var)
  --goal-file <path>         goal file (source of truth, prepended to all prompts)
  --queue-dir <path>         consume task files from a queue directory
  --max <n>                  max tasks per loop (default: 1)
  --sleep <sec>              sleep between loops (default: 5)
  --model <model>            model name passed to agent CLI (default: from config.sh)
  --fallback-model <model>   fallback model if rate limit hit (default: from config.sh)
  --once                     process up to --max tasks then exit (queue mode only)
  --dry-run                  print commands without executing
  -h, --help                 show help

environment:
  AGENT_BIN                  agent CLI path (e.g., ~/.local/bin/agent)
  AGENT_PROVIDER             provider: cursor or antigravity
  CURSOR_API_KEY             cursor api key for authentication
  ANTIGRAVITY_API_KEY         antigravity api key for authentication
  DEFAULT_MODEL              default model name (default: from config.sh)
  FALLBACK_MODEL             fallback model name (default: from config.sh)
  
configuration:
  see agent_factory/config.sh for all configurable settings including:
  - ORCHESTRATOR_SLEEP_SECS, ORCHESTRATOR_MAX_SPAWNS
  - MAX_WORKER_PENDING, MAX_SUBPLANNER_PENDING, JUDGE_PAUSE_ON_PENDING
  - ORCHESTRATOR_MAX_RETRIES, ORCHESTRATOR_BACKOFF_SECS
EOF
}

profile=""
agent_bin="${AGENT_BIN:-}"
provider="${AGENT_PROVIDER:-cursor}"
api_key=""
goal_file=""
queue_dir=""
max_spawns="${ORCHESTRATOR_MAX_SPAWNS}"
sleep_secs="${ORCHESTRATOR_SLEEP_SECS}"
model="${DEFAULT_MODEL}"
fallback_model="${FALLBACK_MODEL}"
model_chain="${MODEL_CHAIN:-}"
model_rate_limit_backoff="${MODEL_RATE_LIMIT_BACKOFF_SECS:-60}"
dry_run="0"
once="0"
shutdown_requested="0"
current_claimed_file=""
shutdown_timeout="${SHUTDOWN_TIMEOUT_SECS}"
shutdown_start_time=""
spawn_last_error_category=""
spawn_last_log_file=""
spawn_last_exit_code=""

shutdown_handler() {
  if [[ "$shutdown_requested" == "0" ]]; then
    shutdown_requested="1"
    shutdown_start_time="$(date +%s)"
    local signal_name=""
    case "$1" in
      SIGTERM) signal_name="SIGTERM" ;;
      SIGINT) signal_name="SIGINT" ;;
      *) signal_name="UNKNOWN" ;;
    esac
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) shutdown signal received ($signal_name); finishing current task..." >&2
  fi
}

trap 'shutdown_handler SIGTERM' SIGTERM
trap 'shutdown_handler SIGINT' SIGINT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      profile="$2"
      shift 2
      ;;
    --goal-file)
      goal_file="$2"
      shift 2
      ;;
    --queue-dir)
      queue_dir="$2"
      shift 2
      ;;
    --agent-bin)
      agent_bin="$2"
      shift 2
      ;;
    --provider)
      provider="$2"
      shift 2
      ;;
    --api-key)
      api_key="$2"
      shift 2
      ;;
    --max)
      max_spawns="$2"
      shift 2
      ;;
    --sleep)
      sleep_secs="$2"
      shift 2
      ;;
    --model)
      model="$2"
      shift 2
      ;;
    --fallback-model)
      fallback_model="$2"
      shift 2
      ;;
    --dry-run)
      dry_run="1"
      shift
      ;;
    --once)
      once="1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

normalize_provider() {
  local input="$1"
  case "$input" in
    anti-gravity) printf '%s' "antigravity" ;;
    antigravity|cursor) printf '%s' "$input" ;;
    *) printf '%s' "$input" ;;
  esac
}

provider="$(normalize_provider "$provider")"
case "$provider" in
  cursor|antigravity)
    ;;
  *)
    echo "unknown provider: $provider (expected: cursor or antigravity)" >&2
    exit 2
    ;;
esac

resolve_path() {
  local input_path="$1"
  if [[ -z "$input_path" ]]; then
    return 0
  fi
  if [[ "$input_path" = /* ]]; then
    printf '%s' "$input_path"
  else
    printf '%s' "${ORIGINAL_PWD}/${input_path}"
  fi
}

log_ts() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

load_credentials() {
  local global_creds="${HOME}/.config/agent_factory/credentials.json"
  local local_creds="${REPO_ROOT}/credentials/secrets.json"
  local creds_payload=""

  if [[ -f "$global_creds" ]] || [[ -f "$local_creds" ]]; then
    creds_payload="$(
      python3 - "$global_creds" "$local_creds" <<'PY' 2>/dev/null || echo ""
import json
import os
import sys
import shlex

def read_json(path):
    if not path or not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}

global_path = sys.argv[1] if len(sys.argv) > 1 else ""
local_path = sys.argv[2] if len(sys.argv) > 2 else ""

merged = {}
merged.update(read_json(global_path))
merged.update(read_json(local_path))

for key, value in merged.items():
    if not isinstance(key, str):
        continue
    if value is None:
        continue
    value_str = str(value)
    print(f"export {key}={shlex.quote(value_str)}")
PY
    )"
  fi

  if [[ -n "$creds_payload" ]]; then
    # shellcheck disable=SC1090
    eval "$creds_payload"
  fi
}

substitute_credentials() {
  local input_file="$1"
  local tmp_file
  tmp_file="$(mktemp)"
  if command -v envsubst >/dev/null 2>&1; then
    envsubst < "$input_file" > "$tmp_file"
  else
    python3 - "$input_file" "$tmp_file" <<'PY' 2>/dev/null || cp "$input_file" "$tmp_file"
import os
import re
import sys
from pathlib import Path

source_path = Path(sys.argv[1])
dest_path = Path(sys.argv[2])
content = source_path.read_text(errors="replace")

def replacer(match):
    key = match.group(1)
    return os.environ.get(key, match.group(0))

content = re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", replacer, content)
dest_path.write_text(content)
PY
  fi
  printf '%s' "$tmp_file"
}

get_execution_mode() {
  local task_file="$1"
  local mode
  mode="$(grep -m1 "^# execution:" "$task_file" 2>/dev/null | cut -d: -f2 | tr -d '[:space:]' || true)"
  if [[ -z "$mode" ]]; then
    mode="$DEFAULT_EXECUTION_MODE"
  fi
  printf '%s' "$mode"
}

get_task_priority_value() {
  local task_file="$1"
  local header_priority=""
  header_priority="$(grep -m1 "^# priority:" "$task_file" 2>/dev/null | cut -d: -f2 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)"
  case "$header_priority" in
    critical) printf '%s' "0" ;;
    high) printf '%s' "10" ;;
    normal) printf '%s' "50" ;;
    low) printf '%s' "90" ;;
    *) 
      local base_name
      base_name="$(basename "$task_file")"
      if [[ "$base_name" =~ ^([0-9][0-9])_ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
      else
        printf '%s' "50"
      fi
      ;;
  esac
}

get_task_rate_limit() {
  local task_file="$1"
  local rate_limit=""
  rate_limit="$(grep -m1 "^# rate_limit:" "$task_file" 2>/dev/null | cut -d: -f2 | tr -d '[:space:]' || true)"
  if [[ -n "$rate_limit" ]] && [[ "$rate_limit" =~ ^[0-9]+$ ]]; then
    printf '%s' "$rate_limit"
    return
  fi
  printf '%s' ""
}

get_next_task() {
  local queue_path="$1"
  local candidates=()
  local task_file
  while IFS= read -r task_file; do
    candidates+=("$task_file")
  done < <(find "$queue_path" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)

  if [[ "${#candidates[@]}" -eq 0 ]]; then
    printf '%s' ""
    return
  fi

  local best_task=""
  local best_priority=""
  for task_file in "${candidates[@]}"; do
    local priority
    priority="$(get_task_priority_value "$task_file")"
    if [[ -z "$best_task" ]] || [[ "$priority" -lt "$best_priority" ]] || [[ "$priority" == "$best_priority" && "$task_file" < "$best_task" ]]; then
      best_task="$task_file"
      best_priority="$priority"
    fi
  done
  printf '%s' "$best_task"
}

replenish_queue() {
  local queue_path="$1"
  local min_size="$2"
  local seed_dir="$3"
  local shuffle="${4:-1}"

  if [[ ! -d "$seed_dir" ]]; then
    return 0
  fi

  local queue_count
  queue_count="$(find "$queue_path" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$queue_count" -lt "$min_size" ]]; then
    local seed_files=()
    while IFS= read -r seed_file; do
      seed_files+=("$seed_file")
    done < <(find "$seed_dir" -maxdepth 1 -type f -name '*.md' 2>/dev/null)

    if [[ "${#seed_files[@]}" -eq 0 ]]; then
      return 0
    fi

    if [[ "$shuffle" == "1" ]] && command -v shuf >/dev/null 2>&1; then
      printf '%s\n' "${seed_files[@]}" | shuf | head -n 10 | while IFS= read -r seed_file; do
        cp "$seed_file" "$queue_path/" 2>/dev/null || true
      done
    else
      for seed_file in "${seed_files[@]}"; do
        cp "$seed_file" "$queue_path/" 2>/dev/null || true
      done
    fi
    log_ts "replenished queue from seeds: ${queue_path}"
  fi
}

set_spawn_status() {
  spawn_last_error_category="$1"
  spawn_last_exit_code="$2"
  spawn_last_log_file="${3:-}"
}

sleep_for_rate_limit() {
  local rate_limit="$1"
  if [[ -n "$rate_limit" ]]; then
    log_ts "rate_limit header detected (${rate_limit}s); sleeping after task"
    sleep "$rate_limit"
  fi
}

profile="$(resolve_path "$profile")"
goal_file="$(resolve_path "$goal_file")"
queue_dir="$(resolve_path "$queue_dir")"

load_credentials

if [[ -z "$profile" ]]; then
  echo "--profile is required" >&2
  exit 2
fi

if [[ ! -f "$profile" ]]; then
  echo "profile not found: $profile" >&2
  exit 2
fi

if [[ -n "$goal_file" && ! -f "$goal_file" ]]; then
  echo "goal file not found: $goal_file" >&2
  exit 2
fi

if [[ -z "$agent_bin" ]]; then
  agent_bin="$(command -v agent || true)"
fi

if [[ -z "$agent_bin" || ! -x "$agent_bin" ]]; then
  echo "agent cli not found; set --agent-bin or AGENT_BIN" >&2
  exit 2
fi

if [[ -z "$api_key" ]]; then
  case "$provider" in
    cursor)
      api_key="${CURSOR_API_KEY:-}"
      ;;
    antigravity)
      api_key="${ANTIGRAVITY_API_KEY:-}"
      ;;
  esac
fi

spawn_with_file() {
  local prompt_file="$1"
  local log_label="${2:-$(basename "$prompt_file")}"
  log_label="${log_label//[^A-Za-z0-9_.-]/_}"
  local model_info_file="${3:-}"
  local tmp_prompt
  tmp_prompt="$(mktemp)"
  local shutdown_logged_in_spawn=""
  
  # build prompt: goal file (if provided) + profile + task file
  if [[ -n "$goal_file" ]]; then
    {
      echo "# GOAL FILE (Source of Truth - Check This First)"
      echo ""
      cat "$goal_file"
      echo ""
      echo "---"
      echo ""
    } >> "$tmp_prompt"
  fi
  cat "$prompt_file" >> "$tmp_prompt"
  
  local profile_content
  profile_content="$(cat "$tmp_prompt")"
  
  if [[ "$dry_run" == "1" ]]; then
    echo "$agent_bin --print --force --api-key '***' --workspace '$(pwd)' ${model:+--model $model }'<prompt from $tmp_prompt (includes goal file if provided)>'"
    rm -f "$tmp_prompt"
    set_spawn_status "dry_run" "0" ""
    return 0
  fi
  local run_ts
  run_ts="$(date -u +%Y%m%d_%H%M%S)"
  local run_date
  run_date="$(date -u +%Y-%m-%d)"
  local log_dir
  log_dir="${REPO_ROOT}/${AGENT_RUNS_LOG_DIR}/${run_date}"
  mkdir -p "$log_dir"
  if [[ -n "${LOG_LATEST_SYMLINK_NAME:-}" ]]; then
    ln -sfn "$log_dir" "$(pwd)/${AGENT_RUNS_LOG_DIR}/${LOG_LATEST_SYMLINK_NAME}" 2>/dev/null || true
  fi
  local log_file
  log_file="$log_dir/${run_ts}_${log_label}.log"
  set_spawn_status "" "0" "$log_file"

  # try with primary model first
  local current_model="${model:-}"
  local use_fallback="0"
  local primary_model="${model:-}"
  
  local args=(--print --force --output-format text --workspace "$(pwd)")
  if [[ -n "$api_key" ]]; then
    args+=(--api-key "$api_key")
  fi
  if [[ -n "$current_model" ]]; then
    args+=(--model "$current_model")
  fi

  # run with a minimal environment to avoid shell integration/env conflicts
  # that can cause the agent cli to exit 0 with empty output.
  local env_args=(env -i "HOME=$HOME" "PATH=$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin")
  if [[ -n "${LANG:-}" ]]; then
    env_args+=("LANG=$LANG")
  fi
  if [[ -n "${LC_ALL:-}" ]]; then
    env_args+=("LC_ALL=$LC_ALL")
  fi

  local log_prefix_script
  log_prefix_script="${AGENT_FACTORY_DIR}/log_prefix.py"
  : > "$log_file"

  # pass the prompt via stdin to avoid argv size limits for large goal/task files
  local max_retries="${ORCHESTRATOR_MAX_RETRIES}"
  local retry_count=0
  local initial_backoff="${ORCHESTRATOR_BACKOFF_SECS}"
  local backoff_secs="$initial_backoff"
  local max_backoff="${ORCHESTRATOR_MAX_BACKOFF_SECS}"
  local is_rate_limit="0"
  local is_transient_error="0"
  local error_category=""
  local timeout_secs="${AGENT_EXECUTION_TIMEOUT_SECS:-1800}"
  local timed_out="0"
  
  while [[ $retry_count -lt $max_retries ]]; do
    local exec_start
    exec_start="$(date +%s)"
    local agent_pid=""
    local timeout_pid=""
    local exit_code_file
    exit_code_file="$(mktemp)"
    
    # run agent with timeout handling
    # use explicit error handling to capture all failure modes
    (
      # ensure subshell errors are captured
      set +e
      local agent_exit=1
      if printf '%s' "$profile_content" | "${env_args[@]}" "$agent_bin" "${args[@]}" 2>&1 | python3 "$log_prefix_script" >>"$log_file" 2>&1; then
        agent_exit=0
      else
        agent_exit=$?
      fi
      # ensure exit code is always written (even if process is killed)
      echo "$agent_exit" > "$exit_code_file" 2>/dev/null || echo "1" > "$exit_code_file"
      exit "$agent_exit"
    ) &
    agent_pid=$!
    
    # timeout monitor process
    (
      sleep "$timeout_secs"
      # check if agent is still running before taking timeout action
      if kill -0 "$agent_pid" 2>/dev/null; then
        {
          echo ""
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "TIMEOUT: agent execution exceeded ${timeout_secs}s timeout"
          echo "killing agent process (PID: $agent_pid)"
          echo "task will be requeued for retry"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo ""
        } | python3 "$log_prefix_script" >> "$log_file" 2>/dev/null || true
        kill -TERM "$agent_pid" 2>/dev/null || true
        sleep 2
        kill -KILL "$agent_pid" 2>/dev/null || true
        # write timeout exit code only if agent was still running (avoid race where agent finishes right at timeout)
        # check exit_code_file: if it doesn't exist or doesn't contain "0", agent didn't finish successfully
        if [[ ! -f "$exit_code_file" ]] || [[ "$(cat "$exit_code_file" 2>/dev/null || echo "")" != "0" ]]; then
          echo "124" > "$exit_code_file"
        fi
      fi
    ) &
    timeout_pid=$!
    
    # wait for agent to complete, but check for shutdown periodically
    # also handle cases where process dies unexpectedly
    local wait_count=0
    local max_wait_checks=3600  # safety limit: 1 hour max wait
    while kill -0 "$agent_pid" 2>/dev/null && [[ $wait_count -lt $max_wait_checks ]]; do
      if [[ "$shutdown_requested" == "1" ]]; then
        # shutdown requested: allow current task to complete but log it
        if [[ -z "${shutdown_logged_in_spawn:-}" ]]; then
          {
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "shutdown requested during agent execution; allowing task to complete..."
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""
          } | python3 "$log_prefix_script" >> "$log_file" 2>/dev/null || true
          shutdown_logged_in_spawn="1"
        fi
      fi
      sleep 1
      wait_count=$((wait_count + 1))
    done
    
    # handle case where process is still running after max wait (shouldn't happen, but safety net)
    if kill -0 "$agent_pid" 2>/dev/null; then
      {
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "WARNING: agent process still running after max wait checks"
        echo "this may indicate a stuck process; forcing termination"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
      } | python3 "$log_prefix_script" >> "$log_file" 2>/dev/null || true
      kill -TERM "$agent_pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$agent_pid" 2>/dev/null || true
      echo "1" > "$exit_code_file" 2>/dev/null || true
    fi
    
    wait "$agent_pid" 2>/dev/null || true
    
    # kill timeout monitor if agent finished early
    kill "$timeout_pid" 2>/dev/null || true
    wait "$timeout_pid" 2>/dev/null || true
    
    # read exit code
    local exit_code=0
    if [[ -f "$exit_code_file" ]]; then
      exit_code="$(cat "$exit_code_file" 2>/dev/null || echo "1")"
      rm -f "$exit_code_file"
    fi
    
    # check if timeout occurred
    if [[ "$exit_code" == "124" ]]; then
      timed_out="1"
      local exec_end
      exec_end="$(date +%s)"
      local exec_duration=$((exec_end - exec_start))
      echo "agent execution timed out after ${exec_duration}s (timeout: ${timeout_secs}s): $log_label" >&2
      rm -f "$tmp_prompt"
      set_spawn_status "timeout" "4" "$log_file"
      return 4
    fi
    
    if [[ "$exit_code" == "0" ]]; then
      # check for empty output even on successful exit (fail fast)
      local log_size_check
      log_size_check="$(wc -c < "$log_file" 2>/dev/null | tr -d ' ' || echo "0")"
      local log_lines_check
      log_lines_check="$(wc -l < "$log_file" 2>/dev/null | tr -d ' ' || echo "0")"
      
      # enhanced empty output detection: check for meaningful content
      # log file should have at least 1 line AND contain some non-whitespace content
      # also check for actual agent output (not just timestamps, separators, or error messages)
      local has_content="0"
      local content_analysis=""
      if [[ -f "$log_file" ]] && [[ -r "$log_file" ]]; then
        # check if log has any non-whitespace lines (excluding empty lines and separators)
        if grep -qE "[^[:space:]]" "$log_file" 2>/dev/null; then
          # logs are timestamp-prefixed per line; strip timestamp prefix for content detection
          local strip_ts_sed
          strip_ts_sed='s/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^ ]+[[:space:]]+//'

          # check if there's actual agent output (not just log prefixes, separators, or error messages)
          # exclude: empty lines, separators (━━), timestamps, error markers, retry messages
          local content_lines
          content_lines="$(
            (sed -E "$strip_ts_sed" "$log_file" 2>/dev/null || true) \
              | (grep -vE "^[[:space:]]*$|^[[:space:]]*━━|^(ERROR|WARNING|INFO|RETRY|RATE LIMIT|TIMEOUT|empty output|NEED-INFO):" 2>/dev/null || true) \
              | (grep -E "[^[:space:]]" 2>/dev/null || true) \
              | wc -l \
              | tr -d ' '
          )"
          if [[ "$content_lines" -ge 1 ]]; then
            has_content="1"
          fi
          # analyze content for better error reporting
          content_analysis="content_lines=${content_lines}, log_size=${log_size_check} bytes"
          
