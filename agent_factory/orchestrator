      echo "  - update agent profiles to explicitly forbid questions"
      echo ""
      echo "task will be requeued for later processing"
      echo "log file: $log_file"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo ""
    } | python3 "$log_prefix_script" >> "$log_file" 2>/dev/null || true
    echo "agent requested input; requeueing: $log_label ($need_info_line)" >&2
    rm -f "$tmp_prompt"
    set_spawn_status "need_info" "3" "$log_file"
    return 3
  fi

  set_spawn_status "" "0" "$log_file"
  
  if [[ "$use_fallback" == "1" ]]; then
    echo "successfully completed with fallback model: $fallback_model" >&2
  fi
  
  # write model info to file if provided
  if [[ -n "$model_info_file" ]]; then
    {
      echo "primary_model=${primary_model:-}"
      echo "final_model=${current_model:-}"
      echo "used_fallback=${use_fallback}"
    } > "$model_info_file"
  fi
  
  # rotate logs periodically (non-blocking, best-effort)
  local log_rotate_script
  log_rotate_script="${AGENT_FACTORY_DIR}/log_rotate.sh"
  if [[ -f "$log_rotate_script" ]] && [[ -x "$log_rotate_script" ]]; then
    "$log_rotate_script" >/dev/null 2>&1 &
  fi
}

spawn_once() {
  spawn_with_file "$profile" "$(basename "$profile")"
}

extract_bash_block() {
  local task_file="$1"
  sed -n '/^```bash/,/^```/p' "$task_file" 2>/dev/null | sed '1d;$d'
}

execute_task_agent_cli() {
  local prompt_file="$1"
  local log_label="$2"
  local model_info_file="$3"
  local original_model="$model"
  local original_fallback="$fallback_model"

  if [[ -n "${model_chain:-}" ]]; then
    local chain_item
    IFS=',' read -ra chain_items <<< "$model_chain"
    for chain_item in "${chain_items[@]}"; do
      chain_item="$(echo "$chain_item" | tr -d '[:space:]')"
      [[ -z "$chain_item" ]] && continue
      model="$chain_item"
      fallback_model=""
      if spawn_with_file "$prompt_file" "$log_label" "$model_info_file"; then
        model="$original_model"
        fallback_model="$original_fallback"
        return 0
      fi
      if [[ "$spawn_last_error_category" == "rate_limit" ]]; then
        log_ts "rate limit detected for model ${chain_item}; backing off ${model_rate_limit_backoff}s before next model"
        sleep "$model_rate_limit_backoff"
        continue
      fi
      model="$original_model"
      fallback_model="$original_fallback"
      return "$spawn_last_exit_code"
    done
    model="$original_model"
    fallback_model="$original_fallback"
    return 1
  fi

  spawn_with_file "$prompt_file" "$log_label" "$model_info_file"
}

execute_task_direct_bash() {
  local task_file="$1"
  local log_label="$2"
  local run_ts
