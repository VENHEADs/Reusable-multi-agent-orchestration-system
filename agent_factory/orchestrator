      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "WARNING: empty or minimal agent output detected"
      echo "log file size: ${log_size} bytes, lines: ${log_lines}"
      echo "has meaningful content: ${has_meaningful_content:-0}"
      echo "agent binary: $agent_bin ($agent_check)"
      echo "environment: $env_check"
      echo "model: ${current_model:-default}"
      echo ""
      echo "this may indicate:"
