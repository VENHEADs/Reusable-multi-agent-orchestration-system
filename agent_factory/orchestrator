    mv "$current_claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
  fi
  
  if [[ "$shutdown_requested" == "1" ]]; then
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) orchestrator shutdown complete" >&2
  fi
}

if [[ -n "$queue_dir" ]]; then
  if [[ ! -d "$queue_dir" ]]; then
    echo "queue dir not found: $queue_dir" >&2
    exit 2
  fi
  consume_queue
else
  spawn_once
fi
