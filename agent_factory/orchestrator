  if [[ -n "${LOG_LATEST_SYMLINK_NAME:-}" ]]; then
    ln -sfn "$log_dir" "$(pwd)/${AGENT_RUNS_LOG_DIR}/${LOG_LATEST_SYMLINK_NAME}" 2>/dev/null || true
  fi
  local log_file
  log_file="$log_dir/${run_ts}_${log_label}.log"
  set_spawn_status "" "0" "$log_file"

  local script_content
  script_content="$(extract_bash_block "$task_file")"
  if [[ -z "$script_content" ]]; then
    {
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "ERROR: direct_bash execution requested but no bash code block found"
      echo "task file: $task_file"
      echo "expected format: ```bash ... ```"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo ""
    } | python3 "${AGENT_FACTORY_DIR}/log_prefix.py" >> "$log_file" 2>/dev/null || true
    set_spawn_status "direct_bash_missing" "1" "$log_file"
    return 1
  fi

  if [[ "$dry_run" == "1" ]]; then
    {
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "DRY RUN: direct_bash execution for $task_file"
      echo "script:"
      echo "$script_content"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo ""
    } | python3 "${AGENT_FACTORY_DIR}/log_prefix.py" >> "$log_file" 2>/dev/null || true
    set_spawn_status "dry_run" "0" "$log_file"
    return 0
  fi

  local timeout_secs="${DIRECT_BASH_TIMEOUT_SECS:-60}"
  local exit_code=0
  if command -v timeout >/dev/null 2>&1; then
    if ! timeout "$timeout_secs" bash -c "$script_content" 2>&1 | python3 "${AGENT_FACTORY_DIR}/log_prefix.py" >> "$log_file"; then
      exit_code=$?
    fi
  else
    if ! bash -c "$script_content" 2>&1 | python3 "${AGENT_FACTORY_DIR}/log_prefix.py" >> "$log_file"; then
      exit_code=$?
    fi
  fi

  if [[ "$exit_code" == "124" ]]; then
    set_spawn_status "timeout" "4" "$log_file"
    return 4
  fi
  if [[ "$exit_code" != "0" ]]; then
    set_spawn_status "execution_failure" "1" "$log_file"
    return 1
  fi
  set_spawn_status "" "0" "$log_file"
  return 0
}

execute_task() {
  local task_file="$1"
  local prompt_file="$2"
  local log_label="$3"
  local model_info_file="$4"
  local mode
  mode="$(get_execution_mode "$task_file")"
  local original_dry_run="$dry_run"
  case "$mode" in
    direct_bash)
      execute_task_direct_bash "$task_file" "$log_label"
      ;;
    dry_run)
      dry_run="1"
      execute_task_agent_cli "$prompt_file" "$log_label" "$model_info_file"
      ;;
    agent_cli|"")
      execute_task_agent_cli "$prompt_file" "$log_label" "$model_info_file"
      ;;
    *)
      log_ts "unknown execution mode '${mode}' in $task_file; defaulting to agent_cli"
      execute_task_agent_cli "$prompt_file" "$log_label" "$model_info_file"
      ;;
  esac
  dry_run="$original_dry_run"
}

consume_queue() {
  local processed_dir="${queue_dir%/}/processed"
  local queue_name
  queue_name="$(basename "$queue_dir")"
  mkdir -p "$processed_dir"
  local max_worker_pending="${MAX_WORKER_PENDING}"
  local judge_pause="${JUDGE_PAUSE_ON_PENDING}"
  local max_subplanner_pending="${MAX_SUBPLANNER_PENDING}"
  local last_rotation_check="$(date +%s)"
  local rotation_check_interval="${LOG_ROTATION_CHECK_INTERVAL_SECS}"
  local queue_sleep="$sleep_secs"
  case "$queue_name" in
    queue) queue_sleep="${QUEUE_WORKER_SLEEP_SECS:-$sleep_secs}" ;;
    subplanner_queue) queue_sleep="${QUEUE_SUBPLANNER_SLEEP_SECS:-$sleep_secs}" ;;
    planner_queue) queue_sleep="${QUEUE_PLANNER_SLEEP_SECS:-$sleep_secs}" ;;
  esac
  while [[ "$shutdown_requested" == "0" ]]; do
    local spawned="0"
    local task_file
    local IFS=$'\n'

    if [[ "$shutdown_requested" == "1" ]]; then
      break
    fi

    if [[ "$queue_name" == "queue" ]]; then
      replenish_queue "$queue_dir" "$MIN_QUEUE_SIZE" "$SEED_TASKS_DIR" "$SEED_SHUFFLE"
    fi

    # pause worker/subplanner when judge has pending work
    if [[ "$judge_pause" == "1" ]]; then
      qbase="$(basename "$queue_dir")"
      if [[ "$qbase" == "queue" || "$qbase" == "subplanner_queue" ]]; then
        judge_pending="$(find "tasks/judge_queue" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
        if [[ "$judge_pending" -gt 0 ]]; then
          if [[ "$shutdown_requested" == "1" ]]; then
            break
          fi
          sleep "$queue_sleep"
          continue
        fi
      fi
    fi

    # throttle sub-planner if worker queue is already large
    if [[ "$(basename "$queue_dir")" == "subplanner_queue" ]]; then
      worker_pending="$(find "tasks/queue" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
      if [[ "$worker_pending" -ge "$max_worker_pending" ]]; then
        if [[ "$shutdown_requested" == "1" ]]; then
          break
        fi
        sleep "$queue_sleep"
        continue
      fi
    fi

    # throttle planner if subplanner queue is already large
    if [[ "$(basename "$queue_dir")" == "planner_queue" ]]; then
      subplanner_pending="$(find "tasks/subplanner_queue" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
      if [[ "$subplanner_pending" -ge "$max_subplanner_pending" ]]; then
        if [[ "$shutdown_requested" == "1" ]]; then
          break
        fi
        sleep "$queue_sleep"
        continue
      fi
    fi

    while true; do
      if [[ "$shutdown_requested" == "1" ]]; then
        break
      fi

      task_file="$(get_next_task "$queue_dir")"
      if [[ -z "$task_file" ]]; then
        break
      fi

      local base_name
      base_name="$(basename "$task_file")"
      local claimed_file
      claimed_file="$processed_dir/$base_name.$(date +%s).$$"
      if ! mv "$task_file" "$claimed_file" 2>/dev/null; then
        continue
      fi
      # ensure processed-time metrics are accurate (mv preserves mtime)
      touch "$claimed_file" 2>/dev/null || true

      current_claimed_file="$claimed_file"
      
      # check for shutdown before starting task
      if [[ "$shutdown_requested" == "1" ]]; then
        echo "shutdown requested before task start; requeueing: $base_name" >&2
        mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
        current_claimed_file=""
        break
      fi

      # blocker handling (00_BLOCKER*.md, BLOCKER_* categories)
      if [[ "$base_name" == 00_BLOCKER* ]] || [[ "$base_name" == BLOCKER_* ]]; then
        if [[ "$base_name" == BLOCKER_HARD_* ]]; then
          log_ts "hard blocker detected, halting: $base_name"
          mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
          current_claimed_file=""
          sleep "$queue_sleep"
          continue
        fi
        case "${BLOCKER_MODE:-stop}" in
          stop)
            log_ts "blocker detected, halting: $base_name"
            mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
            current_claimed_file=""
            sleep "$queue_sleep"
            continue
            ;;
          skip)
            log_ts "blocker detected, skipping: $base_name"
            mv "$claimed_file" "${processed_dir}/${base_name}.skipped" 2>/dev/null || true
            current_claimed_file=""
            spawned=$((spawned + 1))
            if [[ "$spawned" -ge "$max_spawns" ]]; then
              break
            fi
            continue
            ;;
          retry)
            local blocker_state_dir
            blocker_state_dir="${AGENT_FACTORY_STATE_DIR}/blocker_retries"
            mkdir -p "$blocker_state_dir"
            local blocker_state_file="${blocker_state_dir}/${base_name}.json"
            local now_epoch
            now_epoch="$(date +%s)"
            local last_attempt=0
            local attempt_count=0
            if [[ -f "$blocker_state_file" ]]; then
              last_attempt="$(python3 -c "import json; import sys; data=json.load(open('$blocker_state_file')); print(data.get('last_attempt', 0))" 2>/dev/null || echo "0")"
              attempt_count="$(python3 -c "import json; import sys; data=json.load(open('$blocker_state_file')); print(data.get('attempt_count', 0))" 2>/dev/null || echo "0")"
            fi

            if [[ "$attempt_count" -ge "${BLOCKER_MAX_RETRIES}" ]]; then
              log_ts "blocker max retries exceeded, skipping: $base_name"
              mv "$claimed_file" "${processed_dir}/${base_name}.skipped" 2>/dev/null || true
              current_claimed_file=""
              spawned=$((spawned + 1))
              if [[ "$spawned" -ge "$max_spawns" ]]; then
                break
              fi
              continue
            fi

            local next_allowed=$((last_attempt + BLOCKER_RETRY_DELAY_SECS))
            if [[ "$now_epoch" -lt "$next_allowed" ]]; then
              log_ts "blocker retry delay active, requeueing: $base_name"
              mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
              current_claimed_file=""
              sleep "$queue_sleep"
              continue
            fi

            attempt_count=$((attempt_count + 1))
            python3 - <<'PY' "$blocker_state_file" "$now_epoch" "$attempt_count" 2>/dev/null || true
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
payload = {"last_attempt": int(sys.argv[2]), "attempt_count": int(sys.argv[3])}
path.write_text(json.dumps(payload))
PY
            log_ts "blocker retry attempt ${attempt_count}/${BLOCKER_MAX_RETRIES}: $base_name"
            mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
            current_claimed_file=""
            sleep "$BLOCKER_RETRY_DELAY_SECS"
            continue
            ;;
          *)
            log_ts "unknown BLOCKER_MODE '${BLOCKER_MODE}', defaulting to stop"
            mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
            current_claimed_file=""
            sleep "$sleep_secs"
            continue
            ;;
        esac
      fi

      # provenance snapshot (best-effort; requires git)
      local prov_start_ts
      prov_start_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      local prov_start_epoch
      prov_start_epoch="$(date +%s)"
      local before_list
      before_list="$(mktemp)"
      local after_list
      after_list="$(mktemp)"
      local model_info_file
      model_info_file="$(mktemp)"
      local git_commit_hash=""
      local requeue_attempt=0
      
      # get git commit hash if available
      if [[ -d .git ]] && command -v git >/dev/null 2>&1; then
        git_commit_hash="$(git rev-parse HEAD 2>/dev/null || echo "")"
        git status --porcelain 2>/dev/null | awk '{print $2}' | sort -u > "$before_list" || true
      else
        : > "$before_list"
      fi
      
      # check for existing provenance to track requeue attempts
      # find most recent previous attempt (sorted by timestamp in filename)
      local existing_prov
      existing_prov="$(find "$processed_dir" -maxdepth 1 -name "${base_name}.*.provenance.json" 2>/dev/null | sort -r | head -1)"
      local previous_provenance_file=""
      if [[ -n "$existing_prov" && -f "$existing_prov" ]]; then
        previous_provenance_file="$existing_prov"
        requeue_attempt="$(python3 -c "import json, sys; d=json.load(open('$existing_prov')); print(d.get('requeue_attempt', 0) + 1)" 2>/dev/null || echo "1")"
      fi
      
      local substituted_task
      substituted_task="$(substitute_credentials "$claimed_file")"
      local tmp_prompt
      tmp_prompt="$(mktemp)"
      local spawn_result
      spawn_result=0
      
      # build prompt file with error handling
      if ! cat "$profile" "$substituted_task" > "$tmp_prompt" 2>/dev/null; then
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ERROR: failed to build prompt file for $base_name" >&2
        mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
        rm -f "$substituted_task" "$tmp_prompt" "$model_info_file" || true
        current_claimed_file=""
        continue
      fi
      
      # validate prompt file was created and has content
      if [[ ! -f "$tmp_prompt" ]] || [[ ! -s "$tmp_prompt" ]]; then
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ERROR: prompt file is empty or missing for $base_name" >&2
        mv "$claimed_file" "$queue_dir/$base_name" 2>/dev/null || true
        rm -f "$substituted_task" "$tmp_prompt" "$model_info_file" || true
        current_claimed_file=""
        continue
      fi
      
      # run task and allow it to complete even if shutdown is requested
      # capture exit code without crashing the loop
      # use set +e to prevent loop crash on agent failures
      # wrap in subshell to ensure errors don't propagate
      # also capture stderr separately to detect errors even if exit code is 0
      # use explicit error handling to ensure spawn_result is always set
      # isolate errors to prevent orchestrator crash
      # additional protection: ensure all error paths are handled gracefully
      # ensure temporary files are cleaned up even on errors
      set +e
      local spawn_stderr
