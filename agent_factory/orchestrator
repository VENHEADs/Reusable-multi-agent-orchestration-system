  local log_size
  log_size="$(wc -c < "$log_file" 2>/dev/null | tr -d ' ' || echo "0")"
  local log_lines
  log_lines="$(wc -l < "$log_file" 2>/dev/null | tr -d ' ' || echo "0")"
  
  # enhanced content check: verify meaningful content exists
  local has_meaningful_content="0"
  if [[ -f "$log_file" ]] && [[ -r "$log_file" ]] && [[ "$log_size" -gt 0 ]]; then
    local content_check
    content_check="$(
      python3 - "$log_file" <<'PY' 2>/dev/null || echo "0"
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
lines = path.read_text(errors="replace").splitlines()

ts_rx = re.compile(r"^\\d{4}-\\d{2}-\\d{2}T[^ ]+\\s+")
count = 0
for line in lines:
    line = ts_rx.sub("", line)
    if not line.strip():
        continue
    if line.lstrip().startswith("━━"):
        continue
    count += 1

print(count)
PY
    )"
    if [[ "$content_check" -ge 3 ]]; then
