      echo "  - environment configuration issue (check PATH, HOME, LANG)"
      echo "  - prompt file was empty or malformed"
      echo "  - agent CLI binary issue or permission problem"
      echo "  - API authentication failure (silent exit)"
      echo ""
      echo "troubleshooting:"
      echo "  - verify agent CLI is executable: $agent_bin"
      echo "  - test agent CLI manually: echo 'test' | $agent_bin --print --force"
      echo "  - check environment variables are set correctly"
      echo "  - review prompt file size and content"
      echo "  - check for shell integration conflicts"
      echo "  - verify API key is valid and not expired"
      echo ""
      echo "task will be requeued for retry"
      echo "log file: $log_file"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo ""
    } | python3 "$log_prefix_script" >> "$log_file" 2>/dev/null || true
    echo "empty agent output: $log_label (${log_size} bytes, ${log_lines} lines, see $log_file)" >&2
    rm -f "$tmp_prompt"
    set_spawn_status "empty_output" "2" "$log_file"
    return 2
  fi

      # safety net: check for NEED-INFO responses (agent requesting additional information)
      # note: this check is redundant if we detected NEED-INFO in the retry loop (which would have returned early),
      # but serves as a final validation before considering the task successful
      # enhanced detection: check for variations like "NEED-INFO", "NEED INFO", "need-info", etc.
      if grep -qiE "NEED-INFO:|NEED INFO:|need-info:" "$log_file"; then
    local need_info_line
    need_info_line="$(grep -iE "NEED-INFO:" "$log_file" | head -1 | sed 's/^[[:space:]]*//' | head -c 300 || echo "NEED-INFO detected")"
    local need_info_context=""
    need_info_context="$(grep -iE "NEED-INFO:" "$log_file" -A 2 | head -3 | tail -2 | head -c 400 || echo "")"
    {
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "INFO: agent requested additional information"
      echo "request: $need_info_line"
      if [[ -n "$need_info_context" ]]; then
        echo ""
        echo "context:"
        echo "$need_info_context"
      fi
      echo ""
      echo "action required:"
      echo "  - review the agent's request in the log file"
      echo "  - provide the requested information or update the task file"
      echo "  - task will be requeued and processed again after information is available"
      echo ""
      echo "to prevent NEED-INFO responses:"
