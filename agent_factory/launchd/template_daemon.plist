<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.YOUR_PROJECT.ROLE</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>cd "REPO_ROOT"; exec "REPO_ROOT/agent_factory/run_orchestrator" --profile "REPO_ROOT/Agent_profiles/ROLE_PROFILE.md" --goal-file "REPO_ROOT/goal.md" --queue-dir "REPO_ROOT/tasks/QUEUE_DIR" --max 1 --sleep 10 1&gt; &gt;( python3 "REPO_ROOT/agent_factory/log_prefix.py" &gt;&gt; "REPO_ROOT/logs/ROLE.out" ) 2&gt; &gt;( python3 "REPO_ROOT/agent_factory/log_prefix.py" &gt;&gt; "REPO_ROOT/logs/ROLE.err" )</string>
    </array>
    <key>WorkingDirectory</key>
    <string>REPO_ROOT</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>REPO_ROOT/logs/ROLE.out</string>
    <key>StandardErrorPath</key>
    <string>REPO_ROOT/logs/ROLE.err</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>AGENT_BIN</key>
      <string>~/.local/bin/agent</string>
      <key>HOME</key>
      <string>HOME_PATH</string>
      <key>USER</key>
      <string>USER_NAME</string>
      <key>PATH</key>
      <string>REPO_ROOT/.venv/bin:HOME_PATH/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
