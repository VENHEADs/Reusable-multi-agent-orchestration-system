#!/usr/bin/env bash
set -euo pipefail

provider="${AGENT_PROVIDER:-cursor}"
args=("$@")

for ((i=0; i<${#args[@]}; i++)); do
  case "${args[$i]}" in
    --provider)
      if [[ -n "${args[$((i+1))]:-}" ]]; then
        provider="${args[$((i+1))]}"
      fi
      i=$((i + 1))
      ;;
  esac
done

case "$provider" in
  anti-gravity) provider="antigravity" ;;
esac

case "$provider" in
  cursor)
    service_name="${CURSOR_KEYCHAIN_SERVICE:-cursor_cli_api_key}"
    account_name="${CURSOR_KEYCHAIN_ACCOUNT:-$USER}"
    ;;
  antigravity)
    service_name="${ANTIGRAVITY_KEYCHAIN_SERVICE:-antigravity_cli_api_key}"
    account_name="${ANTIGRAVITY_KEYCHAIN_ACCOUNT:-$USER}"
    ;;
  *)
    echo "unknown provider: $provider (expected: cursor or antigravity)" >&2
    exit 2
    ;;
esac

api_key="$(security find-generic-password -a "$account_name" -s "$service_name" -w 2>/dev/null || true)"
if [[ -z "$api_key" ]]; then
  # fallback to stored auth from `agent login` (preferred for personal machines).
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  exec "$repo_root/orchestrator" "$@"
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$repo_root/orchestrator" --api-key "$api_key" "$@"
